# Supabase project credentials
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your-supabase-anon-or-service-role-key

# Postgres connection string used by SQLAlchemy (asyncpg driver).
# Any special characters in the password (@, :, /, %, etc.) must be percent-encoded,
# e.g. a literal "@" in the password becomes "%40".
DATABASE_URL=postgresql+asyncpg://postgres:your-password@your-db-host:5432/postgres

# JWT auth
ALGORITHM=HS256
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_REFRESH_SECRET_KEY=replace-with-a-different-long-random-secret

# Outgoing mail (forgot-password emails)
MAIL_USERNAME=your-email@example.com
MAIL_PASSWORD=your-email-app-password
MAIL_FROM=your-email@example.com

# Optional - only needed if overriding the defaults in app/core/settings/config.py
# MAIL_PORT=465
# MAIL_SERVER=smtp.mail.yahoo.com
# MAIL_STARTTLS=False
# MAIL_SSL_TLS=True
